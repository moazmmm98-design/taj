# ---- Supabase ----
# Get these from your Supabase project → Settings → API
# Leave BOTH empty to run the app in demo mode (in-memory mock data, no persistence).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Admin dashboard password ----
# Optional. Defaults to "admin1234" if not set.
VITE_ADMIN_PASSWORD=admin1234
